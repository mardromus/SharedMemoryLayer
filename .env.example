# =====================================================================
# Shared Memory Layer - environment configuration
#
# Copy to `.env` and fill in the blanks, or run:
#     python scripts/generate_env.py
# which creates `.env` with strong random secrets.
# NEVER commit the real `.env` file.
# =====================================================================

# --- General ---------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Published ports (host side) -----------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Production deployment (docker-compose.prod.yml) -----------------
# Public host name served over HTTPS by Caddy (automatic Let's Encrypt
# certificate). It must resolve to the server; without a domain name use
# <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-10.sslip.io
DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443
# Take the client IP from X-Forwarded-For. Only safe behind the bundled
# proxies (docker-compose.prod.yml sets it); keep false when the API is exposed directly.
TRUST_PROXY_HEADERS=false

# --- PostgreSQL ------------------------------------------------------
POSTGRES_USER=sml
POSTGRES_PASSWORD=
POSTGRES_DB=shared_memory
# Used by the backend container (host "postgres" is the compose service)
DATABASE_URL=postgresql+psycopg://sml:${POSTGRES_PASSWORD}@postgres:5432/shared_memory
# Database used by the automated test-suite (created automatically)
TEST_DATABASE_URL=postgresql+psycopg://sml:${POSTGRES_PASSWORD}@postgres:5432/shared_memory_test

# --- Qdrant ----------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memories

# --- Authentication --------------------------------------------------
# At least 32 random characters. generate_env.py creates one for you.
JWT_SECRET=
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
JWT_EXPIRATION=15
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRATION_DAYS=7
# Set true when served over HTTPS
COOKIE_SECURE=false
# Allow anonymous self-registration (always creates READ_ONLY users)
ALLOW_PUBLIC_REGISTRATION=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Bootstrap administrator (created on first start if missing)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Demo data -------------------------------------------------------
SEED_DEMO_DATA=true
# Password for the seeded human demo users (team managers / reviewers)
DEMO_USER_PASSWORD=

# --- Embeddings ------------------------------------------------------
# fastembed (local ONNX, default) | ollama | openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (agent reasoning layer) -------------------------------------
# none (extractive synthesis, no LLM) | ollama | openai | anthropic
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
OLLAMA_BASE_URL=http://ollama:11434
# CPU threads for Ollama (leave empty for Ollama's default; 4 is a good value on laptops/VMs)
OLLAMA_NUM_THREAD=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# --- Retrieval tuning ------------------------------------------------
SEARCH_DEFAULT_TOP_K=5
SEARCH_SIMILARITY_THRESHOLD=0.55
DUPLICATE_SIMILARITY_THRESHOLD=0.92
CONFLICT_SIMILARITY_THRESHOLD=0.70
MAX_MEMORY_CONTENT_LENGTH=20000

# --- Rate limiting (requests per minute per identity/IP) -------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=120
